// RgenAdapter: optional bridge to r-gen. It stores factory URIs and verifies evidence.
// Nothing in install, premium or settlement requires r-gen. Admin can disable it.
// Placeholders: __ROOT_URI__, __RGEN_ROOT_URI__.
new
  RgenAdapter, rgenState,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack,
  adminGuard, rgenResolve, rgenUri, resolveComponent,
  varianceDim, varianceQuality, varianceQuantity, varianceLiability, varianceCall,
  varianceDeclared, varianceRoute,
  varianceStatusOk, varianceApproved, varianceFirstFailure, varianceVerdict,
  rgenApplyAction
in {
  // @@INLINE:lib/Resolve.rho@@
  // @@INLINE:lib/AdminGuard.rho@@

  contract rgenResolve(@key, ret) = {
    for (@s <<- rgenState) {
      if (s.get("rgenRootUri").length() == 0) {
        ret!((false, "rgen disabled"))
      } else {
        new rCh, Root, kCh in {
          rl!(s.get("rgenRootUri"), *rCh) |
          for (Root <- rCh) {
            Root!("resolve", key, s.get("minVersion"), *kCh) |
            for (@r <- kCh) {
              match r {
                (true, uri, version) => { ret!((true, uri, version)) }
                _ => { ret!((false, "rgen unavailable", key)) }
              }
            }
          }
        }
      }
    }
  } |

  contract rgenUri(@key, ret) = {
    for (@s <<- rgenState) {
      if (s.get("rgenRootUri").length() == 0) {
        ret!((false, "rgen disabled"))
      } else {
        new uCh in {
          rgenResolve!(key, *uCh) |
          for (@u <- uCh) {
            match u {
              (true, uri, _) => {
                new cCh in {
                  rl!(uri, *cCh) |
                  for (C <- cCh) { ret!((true, *C)) }
                }
              }
              _ => { ret!(u) }
            }
          }
        }
      }
    }
  } |

  // K-Asset conventions are validated here: r-gen stores quality/quantity/liability
  // as conventions, not core-enforced shapes. Approval is required; a validated or
  // conditional K-Asset has no liability record, so derivation refuses and the
  // bound variance attestation is the fallback. A value-proposition variance snapshot
  // is used as declared; without one the quality rubric derives the rate.
  contract varianceDim(@v, ret) = {
    match v {
      1 => { ret!(1) }
      2 => { ret!(2) }
      3 => { ret!(3) }
      4 => { ret!(4) }
      5 => { ret!(5) }
      _ => { ret!(0) }
    }
  } |

  contract varianceQuality(@q, ret) = {
    match (q.get("completeness"), q.get("correctness"),
           q.get("traceability"), q.get("fitness")) {
      (a, b, c, d) => {
        new aCh, bCh, cCh, dCh in {
          varianceDim!(a, *aCh) | varianceDim!(b, *bCh) |
          varianceDim!(c, *cCh) | varianceDim!(d, *dCh) |
          for (@x <- aCh; @y <- bCh; @z <- cCh; @w <- dCh) {
            if (x == 0 || y == 0 || z == 0 || w == 0) {
              ret!((false, "quality"))
            } else { ret!((true, x + y + z + w)) }
          }
        }
      }
    }
  } |

  contract varianceQuantity(@q, ret) = {
    match (q.get("unit"), q.get("value")) {
      (unit, value) => {
        if (unit == Nil || value == Nil) {
          ret!((false, "quantity"))
        } else {
          if (unit.length() == 0) {
            ret!((false, "quantity"))
          } else {
            if (value < 1) { ret!((false, "quantity")) }
            else { ret!((true, value)) }
          }
        }
      }
    }
  } |

  contract varianceLiability(@approval, ret) = {
    match approval {
      Nil => { ret!((false, "approval")) }
      a => {
        match a.get("liability") {
          Nil => { ret!((false, "approval")) }
          liability => {
            match (liability.get("responsible"), liability.get("shareBps")) {
              (who, share) => {
                if (who == Nil || share == Nil) {
                  ret!((false, "liability"))
                } else {
                  if (share < 0 || share > 10000) { ret!((false, "liability")) }
                  else { ret!((true, share)) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract varianceCall(@qualitySum, @verdict, @share, @kassetUri, @state, ret) = {
    new mCh in {
      resolveComponent!("component:suremath", *mCh) |
      for (@m <- mCh) {
        match m {
          (true, SureMath) => {
            new vCh in {
              @SureMath!("varianceRate", qualitySum, verdict, *vCh) |
              for (@v <- vCh) {
                match v {
                  (true, varianceBps) => {
                    ret!((true, {
                      "source": "derived",
                      "kasset": kassetUri,
                      "varianceBps": varianceBps,
                      "quantity": state.get("quantity"),
                      "qualitySum": qualitySum,
                      "verdict": verdict,
                      "status": "approved",
                      "liabilityBps": share
                    }))
                  }
                  _ => { ret!(v) }
                }
              }
            }
          }
          _ => { ret!((false, "math unavailable")) }
        }
      }
    }
  } |

  contract RgenAdapter(@"health", ret) = {
    for (@s <<- rgenState) {
      if (s.get("enabled") == false) {
        ret!((false, "disabled"))
      } else {
        new oCh, cCh, kCh, pCh in {
          rgenResolve!("component:oracle-factory", *oCh) |
          rgenResolve!("component:credential-factory", *cCh) |
          rgenResolve!("component:claim-factory", *kCh) |
          rgenResolve!("component:provenance-factory", *pCh) |
          for (@o <- oCh; @c <- cCh; @k <- kCh; @p <- pCh) {
            match (o, c, k, p) {
              ((true, ou, ov), (true, cu, cv), (true, ku, kv), (true, pu, pv)) => {
                ret!((true, {"oracle": ou, "credential": cu, "claim": ku,
                             "provenance": pu, "versions": [ov, cv, kv, pv]}))
              }
              _ => { ret!((false, "rgen unavailable")) }
            }
          }
        }
      }
    }
  } |

  contract RgenAdapter(@"config", ret) = {
    for (@s <<- rgenState) { ret!((true, s)) }
  } |

  contract RgenAdapter(@"oracleFactory", ret) = {
    new cCh in {
      rgenUri!("component:oracle-factory", *cCh) |
      for (@r <- cCh) { ret!(r) }
    }
  } |

  contract RgenAdapter(@"credentialFactory", ret) = {
    new cCh in {
      rgenUri!("component:credential-factory", *cCh) |
      for (@r <- cCh) { ret!(r) }
    }
  } |

  contract RgenAdapter(@"claimFactory", ret) = {
    new cCh in {
      rgenUri!("component:claim-factory", *cCh) |
      for (@r <- cCh) { ret!(r) }
    }
  } |

  contract varianceStatusOk(@status, ret) = {
    match status {
      "approved" => { ret!((true, Nil)) }
      _ => {
        if (status == "validated" || status == "conditional") {
          ret!((false, "approval"))
        } else { ret!((false, "status")) }
      }
    }
  } |

  contract varianceFirstFailure(@q, @n, @l, ret) = {
    match q {
      (false, reason) => { ret!((false, reason)) }
      _ => {
        match n {
          (false, reason) => { ret!((false, reason)) }
          _ => {
            match l {
              (false, reason) => { ret!((false, reason)) }
              _ => { ret!((false, "kasset")) }
            }
          }
        }
      }
    }
  } |

  contract varianceDeclared(@v, @kassetUri, @state, @share, ret) = {
    match (v.get("quantityBps"), v.get("qualityBps"), v.get("n")) {
      (q, b, n) => {
        if (q == Nil || b == Nil || n == Nil || q < 0 || q > 10000
            || b < 0 || b > 10000 || q + b > 10000 || n < 1) {
          ret!((false, "variance"))
        } else {
          ret!((true, {"source": "kasset-variance", "kasset": kassetUri,
                       "varianceBps": q + b, "quantity": state.get("quantity"),
                       "qualitySum": Nil, "verdict": state.get("verdict"),
                       "status": "approved", "liabilityBps": share,
                       "declared": v}))
        }
      }
    }
  } |

  contract varianceRoute(@s, @qualitySum, @share, @kassetUri, ret) = {
    match s.get("variance") {
      Nil => { varianceVerdict!(s, qualitySum, share, kassetUri, *ret) }
      v => { varianceDeclared!(v, kassetUri, s, share, *ret) }
    }
  } |

  contract varianceVerdict(@s, @qualitySum, @share, @kassetUri, ret) = {
    match s.get("verdict") {
      "valid" => {
        varianceCall!(qualitySum, "valid", share, kassetUri, s, *ret)
      }
      "partial" => {
        varianceCall!(qualitySum, "partial", share, kassetUri, s, *ret)
      }
      _ => { ret!((false, "verdict")) }
    }
  } |

  contract varianceApproved(@s, @kassetUri, ret) = {
    new qCh, nCh, lCh in {
      varianceQuality!(s.get("quality"), *qCh) |
      varianceQuantity!(s.get("quantity"), *nCh) |
      varianceLiability!(s.get("approval"), *lCh) |
      for (@q <- qCh; @n <- nCh; @l <- lCh) {
        match (q, n, l) {
          ((true, qualitySum), (true, _), (true, share)) => {
            varianceRoute!(s, qualitySum, share, kassetUri, *ret)
          }
          _ => { varianceFirstFailure!(q, n, l, *ret) }
        }
      }
    }
  } |

  contract RgenAdapter(@"variance", @kassetUri, ret) = {
    if (kassetUri.length() == 0) {
      ret!((false, "kasset"))
    } else {
      new assetCh, gCh in {
        rl!(kassetUri, *assetCh) |
        for (KAsset <- assetCh) {
          KAsset!("get", *gCh) |
          for (@g <- gCh) {
            match g {
              (true, s) => {
                new stCh in {
                  varianceStatusOk!(s.get("status"), *stCh) |
                  for (@st <- stCh) {
                    match st {
                      (true, Nil) => { varianceApproved!(s, kassetUri, *ret) }
                      (false, reason) => { ret!((false, reason)) }
                      _ => { ret!((false, "status")) }
                    }
                  }
                }
              }
              _ => { ret!((false, "kasset")) }
            }
          }
        }
      }
    }
  } |

  contract RgenAdapter(@"verifyCredential", @uri, ret) = {
    new cCh in {
      rgenUri!("component:credential-factory", *cCh) |
      for (@r <- cCh) {
        match r {
          (true, CredentialFactory) => {
            @CredentialFactory!("verify", uri, *ret)
          }
          _ => { ret!(r) }
        }
      }
    }
  } |

  contract RgenAdapter(@"verifyClaim", @uri, ret) = {
    new cCh in {
      rgenUri!("component:claim-factory", *cCh) |
      for (@r <- cCh) {
        match r {
          (true, ClaimFactory) => {
            @ClaimFactory!("verify", uri, *ret)
          }
          _ => { ret!(r) }
        }
      }
    }
  } |

  contract RgenAdapter(@"verifyProvenance", @uri, @hash, ret) = {
    new cCh in {
      rl!(uri, *cCh) |
      for (Provenance <- cCh) {
        Provenance!("verify", hash, *ret)
      }
    }
  } |

  contract rgenApplyAction(@s, @nonce, @action, @args, stateCell, ret) = {
    match action {
      "setRgenRoot" => {
        match args.nth(0) {
          root => {
            stateCell!(s.set("rgenRootUri", root).set("nonce", nonce)) |
            ret!((true, Nil))
          }
        }
      }
      "setEnabled" => {
        match args.nth(0) {
          enabled => {
            if ((enabled == true || enabled == false) == false) {
              stateCell!(s) | ret!((false, "enabled"))
            } else {
              stateCell!(s.set("enabled", enabled).set("nonce", nonce)) |
              ret!((true, Nil))
            }
          }
        }
      }
      "setStrict" => {
        match args.nth(0) {
          strict => {
            if ((strict == true || strict == false) == false) {
              stateCell!(s) | ret!((false, "strict"))
            } else {
              stateCell!(s.set("strictCredentials", strict).set("nonce", nonce)) |
              ret!((true, Nil))
            }
          }
        }
      }
      _ => { stateCell!(s) | ret!((false, "unknown action")) }
    }
  } |

  contract RgenAdapter(@"admin", @nonce, @action, @args, @sigs, ret) = {
    for (@s <- rgenState) {
      if (nonce <= s.get("nonce")) {
        rgenState!(s) | ret!((false, "replay"))
      } else {
        new uCh in {
          resolveComponent!("component:admin", *uCh) |
          for (@u <- uCh) {
            match u {
              (true, SureAdmin) => {
                new kCh in {
                  @SureAdmin!("keys", *kCh) |
                  for (@k <- kCh) {
                    match k {
                      (true, admins, threshold) => {
                        new vCh in {
                          adminGuard!("rgen", nonce, action, args, sigs,
                                       admins, threshold, *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, ok) => {
                                if (ok == false) {
                                  rgenState!(s) | ret!((false, "below threshold"))
                                } else {
                                  rgenApplyAction!(s, nonce, action, args, *rgenState, *ret)
                                }
                              }
                              _ => { rgenState!(s) | ret!((false, "below threshold")) }
                            }
                          }
                        }
                      }
                      _ => { rgenState!(s) | ret!((false, "admin unavailable")) }
                    }
                  }
                }
              }
              _ => { rgenState!(s) | ret!((false, "admin unavailable")) }
            }
          }
        }
      }
    }
  } |

  rgenState!({
    "rgenRootUri": "__RGEN_ROOT_URI__",
    "minVersion": 1,
    "enabled": false,
    "strictCredentials": false,
    "nonce": 0
  }) |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*RgenAdapter}, *c) |
    for (@uri <- c) {
      Root!("register", "component:rgen", uri, 1, "adapter", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
